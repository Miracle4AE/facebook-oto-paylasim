# SQLite (geliştirme). PostgreSQL için örnek:
# DATABASE_URL="postgresql://kullanici:sifre@host:5432/veritabani?schema=public"
DATABASE_URL="file:./dev.db"

NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# Vercel Cron veya manuel tetikleme koruması
CRON_SECRET=""

NEXT_PUBLIC_APP_NAME="Facebook Otomatik Paylaşım Paneli"

# mock (varsayılan) veya graph — gerçek Graph çağrıları için graph + token gerekir
# FACEBOOK_PUBLISH_MODE="graph"
# Mock modda başarı olasılığı (0–1, örn. 0.62)
# FACEBOOK_MOCK_SUCCESS_RATE="0.62"

# Gerçek Facebook Graph API (OAuth + yayın için gerekli)
# Meta uygulamasında geçerli OAuth redirect URI: {NEXTAUTH_URL}/api/auth/facebook/callback
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""
# FACEBOOK_GRAPH_VERSION="v21.0"
# FACEBOOK_PUBLISH_MODE="graph"
# Token şifreleme (tercihen 32 bayt, base64): openssl rand -base64 32
# Belirtilmezse NEXTAUTH_SECRET türetilir (üretimde ayrı anahtar önerilir)
# TOKEN_ENCRYPTION_KEY=""

# İleride bulut depolama
# MEDIA_STORAGE_DRIVER="local"
