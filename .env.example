# =============================================================================
# YEREL GELİŞTİRME (.env dosyasını kopyala: cp .env.example .env)
# Sıra: aşağıdaki 1–5 satırı aynen doldur. Secret için: npm run env:secrets
# =============================================================================

# 1) Veritabanı — PostgreSQL (Neon veya Supabase connection string; yerelde de aynı mantık)
# Örnek: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# 2) Uygulama adresi (yerelde hep bu)
NEXTAUTH_URL="http://localhost:3000"

# 3) NextAuth şifreleme anahtarı (npm run env:secrets çıktısından NEXTAUTH_SECRET satırı)
NEXTAUTH_SECRET=""

# 4) Cron API koruması (npm run env:secrets çıktısından CRON_SECRET satırı)
CRON_SECRET=""

# 5) Panelde görünen isim (istediğin metin)
NEXT_PUBLIC_APP_NAME="Facebook Otomatik Paylaşım Paneli"

# İsteğe bağlı: seed ve tek seferlik /api/admin/bootstrap varsayılan yönetici şifresi (yoksa Ae080919941827)
# ADMIN_BOOTSTRAP_PASSWORD=""

# =============================================================================
# VERCEL (dosyaya yazma — Vercel → Project → Settings → Environment Variables)
# Sıra ile ekle; Production işaretle. DATABASE_URL Neon/Supabase’ten gelir.
# =============================================================================
#
# 1) NEXT_PUBLIC_APP_NAME     →  Facebook Otomatik Paylaşım Paneli
# 2) NEXTAUTH_URL             →  https://BURAYA-KENDI-VERCEL-ADIN.vercel.app
# 3) NEXTAUTH_SECRET          →  npm run env:secrets ile YENİ üret (yereldekiyle aynı olmak zorunda değil)
# 4) CRON_SECRET              →  npm run env:secrets ile ikinci satır veya tekrar çalıştır
# 5) DATABASE_URL             →  postgresql://... (SQLite file: kullanma)
#
# Deploy bittikten sonra NEXTAUTH_URL’i Vercel’in verdiği tam URL ile aynı yap; gerekirse Redeploy.
#
# Tek seferlik yönetici (admin) oluşturmak için (CLI seed yoksa):
# 6) ADMIN_BOOTSTRAP_SECRET → openssl rand -base64 32 ile üret, sonra bir kez:
#    curl -X POST "https://PROJE.vercel.app/api/admin/bootstrap" -H "Authorization: Bearer AYNI_SECRET"
# İşlem bitince Vercel’den ADMIN_BOOTSTRAP_SECRET’i kaldırın veya boş bırakın.
# =============================================================================

# mock (varsayılan) veya graph — gerçek Graph çağrıları için graph + token gerekir
# FACEBOOK_PUBLISH_MODE="graph"
# FACEBOOK_MOCK_SUCCESS_RATE="0.62"

# Meta uygulamasında OAuth redirect: {NEXTAUTH_URL}/api/auth/facebook/callback
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""
# FACEBOOK_GRAPH_VERSION="v21.0"
# TOKEN_ENCRYPTION_KEY=""

# MEDIA_STORAGE_DRIVER="local"
